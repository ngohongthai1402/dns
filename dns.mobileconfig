<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

<!-- THÔNG TIN CHÍNH -->
<key>PayloadDisplayName</key>
<<string>NHT DNS🔫</string>  
<key>PayloadDescription</key>  
<string>✔ Chặn thu hồi chứng chỉ
✔ Không hao pin, ổn định hơn VPN
✔ Hỗ trợ iPhone, iPad
✔ Tương thích mọi phiên bản iOS
✔ Cài speed liên hệ ở dưới
💬Zalo: 0349 3333 97</string>

<key>PayloadIdentifier</key>
<string>com.nht.dns.vipreal</string>

<key>PayloadScope</key>
<string>System</string>

<key>PayloadType</key>
<string>Configuration</string>

<key>PayloadUUID</key>
<string>9A1B2C3D-4E5F-6789-ABCD-112233445566</string>

<key>PayloadVersion</key>
<integer>1</integer>

<key>PayloadOrganization</key>
<string>🚀 nhtspeed.bio.link</string>

<!-- NỘI DUNG -->
<key>PayloadContent</key>
<array>

    <dict>

        <key>PayloadType</key>
        <string>com.apple.dnsSettings.managed</string>

        <key>PayloadVersion</key>
        <integer>1</integer>

        <key>PayloadIdentifier</key>
        <string>com.nht.dns.secure</string>

        <key>PayloadUUID</key>
        <string>AA11BB22-CC33-DD44-EE55-FF6677889900</string>

        <key>PayloadDisplayName</key>
        <string>Ultra DNS Shield 🛡️</string>

        <key>DNSSettings</key>
        <dict>

            <!-- Giao thức -->
            <key>DNSProtocol</key>
            <string>HTTPS</string>

            <!-- DNS chính -->
            <key>ServerURL</key>
            <string>https://dns.adguard.com/dns-query</string>

            <!-- DNS phụ -->
            <key>FallbackServerURL</key>
            <string>https://cloudflare-dns.com/dns-query</string>

            <!-- Tự failover -->
            <key>AllowFailover</key>
            <true/>

            <!-- Áp dụng toàn hệ thống -->
            <key>MatchDomains</key>
            <array>
                <string></string>
            </array>

            <!-- DOMAIN CHẶN -->
            <key>SupplementalMatchDomains</key>
            <array>

                <!-- Apple revoke FULL -->
                <string>ocsp.apple.com</string>
                <string>ocsp2.apple.com</string>
                <string>crl.apple.com</string>
                <string>certs.apple.com</string>
                <string>valid.apple.com</string>
                <string>ppq.apple.com</string>
                <string>gdmf.apple.com</string>
                <string>mesu.apple.com</string>
                <string>xp.apple.com</string>
                <string>gs.apple.com</string>

                <!-- SSL -->
                <string>ocsp.int-x3.letsencrypt.org</string>
                <string>ocsp.r2m02.amazontrust.com</string>

                <!-- ADS + TRACKING -->
                <string>doubleclick.net</string>
                <string>googlesyndication.com</string>
                <string>pagead2.googlesyndication.com</string>
                <string>adservice.google.com</string>
                <string>ads.yahoo.com</string>
                <string>facebookads.com</string>
                <string>ads.twitter.com</string>
                <string>analytics.google.com</string>
                <string>tracking.facebook.com</string>
                <string>app-measurement.com</string>

            </array>

        </dict>

    </dict>

</array>

</dict>
</plist>
