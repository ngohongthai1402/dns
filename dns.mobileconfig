<?xml version="1.0" encoding="UTF-8"?>  
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">  
<plist version="1.0">  
<dict>  

<key>PayloadDisplayName</key>  
<string>NHT DNS🔫</string>  

<key>PayloadDescription</key>  
<string>🌐nhtspeed.bio.link
✔ Không hao pin, ổn định hơn
✔ Chặn thu hồi chứng chỉ an toàn
✔ Tương thích mọi phiên bản iOS
✔ Tăng tốc + giảm delay
✔ Hỗ trợ iPhone, iPad
💬 Zalo: 0349 3333 97</string>

<key>PayloadIdentifier</key>  
<string>com.nht.dns.combo</string>  

<key>PayloadScope</key>  
<string>System</string>  

<key>PayloadType</key>  
<string>Configuration</string>  

<key>PayloadUUID</key>  
<string>COMBO-1234-5678-ABCD-112233445566</string>  

<key>PayloadVersion</key>  
<integer>1</integer>  

<key>PayloadOrganization</key>  
<string>I AM NHT PRO🚀</string>  

<key>PayloadContent</key>  
<array>  

    <dict>  
        <key>PayloadType</key>  
        <string>com.apple.dnsSettings.managed</string>  

        <key>PayloadVersion</key>  
        <integer>1</integer>  

        <key>PayloadIdentifier</key>  
        <string>com.nht.dns.combo.secure</string>  

        <key>PayloadUUID</key>  
        <string>DNS-COMBO-0001-0002</string>  

        <key>PayloadDisplayName</key>  
        <string>Ultra DNS Combo ⚡</string>  

        <key>DNSSettings</key>  
        <dict>  

            <!-- Giao thức -->
            <key>DNSProtocol</key>  
            <string>HTTPS</string>  

            <!-- DNS CHÍNH: NextDNS -->
            <key>ServerURL</key>  
            <string>https://dns.nextdns.io/f4b567</string>  

            <!-- DNS PHỤ: AdGuard -->
            <key>FallbackServerURL</key>  
            <string>https://dns.adguard.com/dns-query</string>  

            <!-- Failover -->
            <key>AllowFailover</key>  
            <true/>  

            <!-- Domain chặn -->
            <key>SupplementalMatchDomains</key>  
            <array>  

                <!-- Apple revoke SAFE -->
                <string>ocsp.apple.com</string>  
                <string>ocsp2.apple.com</string>  
                <string>crl.apple.com</string>  

                <!-- SSL -->
                <string>ocsp.int-x3.letsencrypt.org</string>  

                <!-- Ads nhẹ -->
                <string>doubleclick.net</string>  
                <string>googlesyndication.com</string>  
                <string>adservice.google.com</string>  

            </array>  

        </dict>  

    </dict>  

</array>  

</dict>  
</plist>
